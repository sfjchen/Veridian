# Whiteboard demo: skip sign-in and open Sample Algebra directly (no accounts).
EXPO_PUBLIC_DEMO_MODE=1

# Production (Vercel): point at Render student backend — set in Vercel project env, not committed.
# EXPO_PUBLIC_BACKEND_URL=https://YOUR-SERVICE.onrender.com
EXPO_PUBLIC_BACKEND_URL=

# Supabase — Jchen04 Veridian project tpqasmpieyteutvdntda
EXPO_PUBLIC_SUPABASE_URL=https://tpqasmpieyteutvdntda.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Supabase user JWT. If set, used as Bearer token; otherwise sign in via the app.
EXPO_PUBLIC_SUPABASE_ACCESS_TOKEN=

# iOS Simulator: use 127.0.0.1 so the simulator can reach Metro (avoids "Operation timed out" on LAN).
# Uncomment if iOS simulator fails to open the app; or use: npm run ios:localhost
# REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1
