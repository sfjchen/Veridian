OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5-20250929

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...
SUPABASE_DEFAULT_OWNER_ID=00000000-0000-0000-0000-000000000000
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
SUPABASE_ARTIFACTS_TABLE=veridian_artifacts
SUPABASE_COORD_RUNS_TABLE=veridian_mistake_coord_runs

# Optional: math OCR speed vs quality (defaults are tuned for speed)
# MATH_OCR_MODEL=gpt-4o-mini
# MATH_OCR_IMAGE_DETAIL=low
# MATH_OCR_MAX_IMAGE_SIDE=1024
# For denser handwriting try MATH_OCR_IMAGE_DETAIL=high and/or MATH_OCR_MAX_IMAGE_SIDE=1536
# MATH_OCR_DEBUG=1  # log handwriting_ocr_ms to stderr
# ANALYSIS_PROFILE=1  # log ocr/mistake_analysis/coords ms to stderr; include timing_ms in /analyze-solution JSON

# Optional: faster/cheaper analysis (mistake detection uses Opus by default; Sonnet is quicker and cheaper)
# MISTAKE_ANALYSIS_MODEL=claude-sonnet-4-5-20250929
# MISTAKE_ANALYSIS_THINKING=0  # disable extended thinking on Opus for lower latency/cost
# MISTAKE_ANALYSIS_MAX_TOKENS=8192  # cap output length for analyze/verify/continuation (default 8192)
# MISTAKE_ANALYSIS_BACKEND=openai  # use OpenAI for analyze/verify/continuation (default anthropic)
# MISTAKE_ANALYSIS_OPENAI_MODEL=gpt-4o  # when backend=openai (default gpt-4o; gpt-4o-mini for faster/cheaper)
