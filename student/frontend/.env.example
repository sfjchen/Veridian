# Backend URL for submitting captured work (POST /analyze-solution).
# Point this at your Flask backend (python get_coords.py).
# iOS simulator: use http://localhost:8000
# Android emulator: use http://10.0.2.2:8000
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.x:8000
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: pass a Supabase access token so backend artifact writes are owned by this user.
# If omitted, backend must set SUPABASE_DEFAULT_OWNER_ID.
EXPO_PUBLIC_SUPABASE_ACCESS_TOKEN=

# iOS Simulator: use 127.0.0.1 so the simulator can reach Metro (avoids "Operation timed out" on LAN).
# Uncomment if iOS simulator fails to open the app; or use: npm run ios:localhost
# REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1
